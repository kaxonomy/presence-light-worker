{
  "name": "presence-light-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
